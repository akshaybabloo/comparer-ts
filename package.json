{
  "name": "comparer-ts",
  "version": "0.0.0",
  "description": "A TypeScript library for diffing strings, folders and images, powered by WebAssembly",
  "author": "Akshay Raj Gollahalli <akshay@gollahalli.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshaybabloo/comparer-ts.git"
  },
  "bugs": {
    "url": "https://github.com/akshaybabloo/comparer-ts/issues"
  },
  "homepage": "https://github.com/akshaybabloo/comparer-ts#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/comparer.es.js",
  "module": "./dist/comparer.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/comparer.es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "wasm-pack build crates/comparer --target bundler",
    "build:bindings": "cargo test -p comparer -p folder-diff -p text-diff --lib",
    "build": "pnpm run build:wasm && pnpm run build:bindings && vite build",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test",
    "test:ts": "vitest run",
    "test": "pnpm run build:wasm && pnpm run test:rust && pnpm run test:ts",
    "fmt": "prettier --write \"src/**/*.{ts,js,json,css,md}\" \"*.{js,json,md}\"",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "typescript",
    "diff",
    "webassembly",
    "wasm",
    "comparer",
    "file-diff",
    "folder-diff",
    "image-diff"
  ],
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.4"
  }
}
